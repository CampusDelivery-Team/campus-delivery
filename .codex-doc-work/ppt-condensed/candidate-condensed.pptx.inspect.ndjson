{"kind":"textbox","id":"sh/jmd83atk","slide":15,"name":"code-text","text":"-- database-enhancement/03_procedures.sql\n+CREATE OR REPLACE PROCEDURE sp_accept_task_atomic (...) AS\n+BEGIN\n+  SELECT task_status, publisher_user_id\n+    INTO v_task_status, v_publisher_user_id\n+    FROM tasks WHERE task_id = p_task_id FOR UPDATE;\n+\n+  IF v_task_status <> 'WAITING' THEN\n+    p_result_code := 'TASK_NOT_WAITING'; RETURN;\n+  END IF;\n+\n+  UPDATE tasks SET task_status = 'ASSIGNED'\n+   WHERE task_id = p_task_id AND task_status = 'WAITING';\n+  UPDATE runners SET work_status = 'BUSY'\n+   WHERE runner_id = p_runner_id;\n+  INSERT INTO assign_records (...) RETURNING record_id INTO p_record_id;\n+  INSERT INTO task_status_logs (...);\n+  p_result_code := 'SUCCESS';\n+END;\n+-- AssignRepository 负责统一 COMMIT / ROLLBACK","textPreview":"-- database-enhancement/03_procedures.sql | +CREATE OR REPLACE PROCEDURE sp_accept_task_atomic (...) AS | +BEGIN | +  SELECT task_status,...","textChars":727,"textLines":20,"bbox":[85.33,149.33,640,485.33]}
