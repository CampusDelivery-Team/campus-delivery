@model CampusRunnerSystem.ViewModels.ServiceTypeViewModel
@{
    ViewData["Title"] = "删除服务类型";
}

<h1 class="h4 mb-3">删除服务类型</h1>

@if (!string.IsNullOrWhiteSpace(TempData["ErrorMessage"] as string))
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="alert alert-warning">
    确认删除服务类型“@Model.ServiceName”吗？如果该服务类型已被任务或服务节点规则引用，将不能删除。
</div>

<form asp-action="DeleteConfirmed" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="serviceTypeId" value="@Model.ServiceTypeId" />
    <button class="btn btn-danger" type="submit">确认删除</button>
    <a class="btn btn-outline-secondary" asp-action="Index">取消</a>
</form>
