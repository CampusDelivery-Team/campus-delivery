@model List<CampusRunnerSystem.ViewModels.ServiceTypeViewModel>
@{
    ViewData["Title"] = "服务类型管理";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <h1 class="h4 mb-0">服务类型管理</h1>
    <a class="btn btn-primary btn-sm" asp-action="Create">新增服务类型</a>
</div>

@if (!string.IsNullOrWhiteSpace(ViewBag.SuccessMessage as string))
{
    <div class="alert alert-success">@ViewBag.SuccessMessage</div>
}
@if (!string.IsNullOrWhiteSpace(ViewBag.ErrorMessage as string))
{
    <div class="alert alert-danger">@ViewBag.ErrorMessage</div>
}

@if (Model.Count == 0 && string.IsNullOrWhiteSpace(ViewBag.ErrorMessage as string))
{
    <div class="alert alert-info">暂无服务类型数据</div>
}
else if (Model.Count > 0)
{
    <div class="table-responsive">
        <table class="table table-bordered table-hover align-middle bg-white">
            <thead class="table-light">
                <tr>
                    <th>服务类型编号</th>
                    <th>服务名称</th>
                    <th>基础价格</th>
                    <th>距离规则</th>
                    <th>加急规则</th>
                    <th>类型状态</th>
                    <th class="text-nowrap">操作</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.ServiceTypeId</td>
                        <td>@item.ServiceName</td>
                        <td>@item.BasePrice.ToString("0.00")</td>
                        <td>@item.DistanceRule</td>
                        <td>@item.UrgentRule</td>
                        <td>@item.TypeStatus</td>
                        <td class="text-nowrap">
                            <a class="btn btn-outline-secondary btn-sm" asp-action="Details" asp-route-id="@item.ServiceTypeId">详情</a>
                            <a class="btn btn-outline-primary btn-sm" asp-action="Edit" asp-route-id="@item.ServiceTypeId">修改</a>
                            <a class="btn btn-outline-danger btn-sm" asp-action="Delete" asp-route-id="@item.ServiceTypeId">删除</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
