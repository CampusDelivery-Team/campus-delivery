@model CampusDelivery.Api.Presentation.ViewModels.AddressViewModel
@{
    ViewData["Title"] = "新增地址";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="card shadow-sm border-0 rounded-lg">
                <div class="card-header bg-success text-white py-3">
                    <h5 class="mb-0">新增收货地址</h5>
                </div>
                <div class="card-body p-4">
                    
                    <form asp-controller="Address" asp-action="Create" method="post" autocomplete="off">
                        <div asp-validation-summary="ModelOnly" class="text-danger fw-bold mb-3"></div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="ContactName" class="form-label fw-bold text-dark">联系人姓名</label>
                                <input asp-for="ContactName" class="form-control" placeholder="例如：张三" autocomplete="off" />
                                <span asp-validation-for="ContactName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="ContactPhone" class="form-label fw-bold text-dark">联系电话</label>
                                <input asp-for="ContactPhone" class="form-control" placeholder="11位手机号码" autocomplete="off" />
                                <span asp-validation-for="ContactPhone" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Campus" class="form-label fw-bold text-dark">校区</label>
                            <input asp-for="Campus" class="form-control" placeholder="例如：嘉定校区、四平路校区" autocomplete="off" />
                            <span asp-validation-for="Campus" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="BuildingRoom" class="form-label fw-bold text-dark">详细楼栋与房间号</label>
                            <input asp-for="BuildingRoom" class="form-control" placeholder="例如：学生公寓6号楼 302室" autocomplete="off" />
                            <span asp-validation-for="BuildingRoom" class="text-danger small"></span>
                        </div>

                        <div class="d-flex align-items-center mb-4 mt-3">
                             <label class="form-check-label text-dark me-2" for="isDefaultCheck" style="font-size: 1.15rem; cursor: pointer;">
                                  每次下单时默认使用该地址
                             </label>
                             <input class="form-check-input mt-0" type="checkbox" name="IsDefault" value="Y" id="isDefaultCheck" style="width: 1.25em; height: 1.25em; cursor: pointer;">
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <a href="/Address/Index" class="btn btn-secondary px-4">返回列表</a>
                            <button type="submit" class="btn btn-success px-4">保存地址</button>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>
