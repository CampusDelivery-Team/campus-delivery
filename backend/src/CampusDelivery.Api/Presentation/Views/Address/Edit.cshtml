@model CampusDelivery.Api.Presentation.ViewModels.AddressViewModel
@{
    ViewData["Title"] = "编辑收货地址";
}

<section class="address-form-page">
    <div class="address-form-page__heading">
        <p class="eyebrow">EDIT DELIVERY ADDRESS</p>
        <h1>编辑收货地址</h1>
        <p>更新后，后续校园跑腿任务会使用新的收货信息。</p>
    </div>

    <form class="address-form" asp-controller="Address" asp-action="Edit" method="post" autocomplete="off">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
        <input type="hidden" asp-for="AddressNo" />
        <div class="address-form__grid">
            <div class="address-form__field">
                <label asp-for="ContactName">联系人</label>
                <input asp-for="ContactName" placeholder="例如：张同学" />
                <span asp-validation-for="ContactName" class="validation-message"></span>
            </div>
            <div class="address-form__field">
                <label asp-for="ContactPhone">联系电话</label>
                <input asp-for="ContactPhone" autocomplete="tel" placeholder="11 位手机号" />
                <span asp-validation-for="ContactPhone" class="validation-message"></span>
            </div>
        </div>
        <div class="address-form__field">
            <label asp-for="Campus">校区</label>
            <input asp-for="Campus" placeholder="例如：嘉定校区" />
            <span asp-validation-for="Campus" class="validation-message"></span>
        </div>
        <div class="address-form__field">
            <label asp-for="BuildingRoom">楼栋与房间</label>
            <input asp-for="BuildingRoom" placeholder="例如：学生公寓 6 号楼 302 室" />
            <span asp-validation-for="BuildingRoom" class="validation-message"></span>
        </div>
        <label class="address-default-choice">
            <input type="checkbox" name="IsDefault" value="Y" @(Model.IsDefault == "Y" ? "checked" : null) />
            <span>设为默认收货地址</span>
        </label>
        <div class="profile-footer-actions">
            <a class="button" asp-controller="Address" asp-action="Index">取消</a>
            <button type="submit" class="button primary">保存修改</button>
        </div>
    </form>
</section>
