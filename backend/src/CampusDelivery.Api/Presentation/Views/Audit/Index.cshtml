@model AuditIndexViewModel

@{
    ViewData["Title"] = "审计日志";
}

<section class="panel management-panel ops-page">
    <div class="section-header management-heading">
        <div>
            <p class="eyebrow">AUDIT</p>
            <h1>运营审计日志</h1>
            <p class="section-description">管理员对支付、退款和任务状态日志进行核验，并记录通过或异常结果。</p>
        </div>
        <div class="actions">
            <a class="button primary" asp-action="Create" asp-route-auditObject="PAYMENT">审计支付</a>
            <a class="button" asp-action="Create" asp-route-auditObject="REFUND">审计退款</a>
            <a class="button" asp-action="Create" asp-route-auditObject="LOG">审计状态日志</a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] is string success)
    {
        <div class="task-alert task-alert--success">@success</div>
    }
    @if (TempData["ErrorMessage"] is string error)
    {
        <div class="task-alert task-alert--error">@error</div>
    }

    <div class="summary-strip ops-summary">
        <div>
            <strong>@Model.PaymentTargetCount</strong>
            <span>支付记录</span>
        </div>
        <div>
            <strong>@Model.RefundTargetCount</strong>
            <span>退款记录</span>
        </div>
        <div>
            <strong>@Model.StatusLogTargetCount</strong>
            <span>状态日志</span>
        </div>
    </div>

    <div class="table-wrap">
        <table class="management-table">
            <thead>
                <tr>
                    <th>审计编号</th>
                    <th>对象类型</th>
                    <th>结果</th>
                    <th>关联数量</th>
                    <th>异常说明</th>
                    <th>审计时间</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Logs.Count == 0)
                {
                    <tr><td colspan="6" class="empty task-table__empty">暂无审计记录。</td></tr>
                }
                else
                {
                    foreach (var item in Model.Logs)
                    {
                        <tr>
                            <td>#@item.AuditId</td>
                            <td>@item.AuditObjectDisplayName</td>
                            <td><span class="badge @(item.AuditResult == "PASS" ? "success" : "danger")">@item.AuditResultDisplayName</span></td>
                            <td>@item.RelatedCount</td>
                            <td>@(string.IsNullOrWhiteSpace(item.ExceptionNote) ? "—" : item.ExceptionNote)</td>
                            <td>@item.AuditedAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</section>

