@model CampusDelivery.Api.Presentation.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "系统登录";
}

<section class="auth-page">
    <div class="auth-intro">
        <p class="eyebrow">WELCOME BACK</p>
        <h1>登录校园跑腿服务</h1>
        <p>登录后，系统会依据账户角色开放个人资料、跑腿员资格或基础资料管理入口。</p>
        <a asp-controller="Home" asp-action="Index">返回首页</a>
    </div>

    <div class="auth-card">
        <div class="auth-card__heading">
            <p class="eyebrow">SIGN IN</p>
            <h2>账户登录</h2>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="inline-notice" role="status">@TempData["SuccessMessage"]</div>
        }

        <form class="auth-form" asp-controller="Auth" asp-action="Login" method="post" autocomplete="off">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
            <div class="auth-field">
                <label asp-for="Username">账号</label>
                <input asp-for="Username" placeholder="请输入账号" autocomplete="username" />
                <span asp-validation-for="Username" class="validation-message"></span>
            </div>
            <div class="auth-field">
                <label asp-for="Password">密码</label>
                <input asp-for="Password" placeholder="请输入密码" autocomplete="current-password" />
                <span asp-validation-for="Password" class="validation-message"></span>
            </div>
            <button class="button primary auth-submit" type="submit">登录</button>
        </form>

        <p class="auth-switch">还没有账号？<a asp-controller="Auth" asp-action="Register">注册新账号</a></p>
    </div>
</section>
