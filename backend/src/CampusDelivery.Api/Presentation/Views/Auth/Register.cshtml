@model CampusDelivery.Api.Presentation.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "用户注册";
}

<section class="auth-page auth-page--register">
    <div class="auth-intro">
        <img class="auth-brand-mark" src="~/images/jirun-mark-128.png" alt="" />
        <p class="eyebrow">JOIN JIRUN</p>
        <h1>创建济跑跑账号</h1>
        <p>注册后即可发布校园跑腿任务；需要参与配送时，再提交跑腿员资格申请。</p>
        <img class="auth-visual" src="~/images/jirun-admin-visual.png" alt="济跑跑校园订单运营视觉图" />
    </div>

    <div class="auth-card">
        <div class="auth-card__heading">
            <p class="eyebrow">REGISTER</p>
            <h2>创建新账号</h2>
        </div>
        <form class="auth-form" asp-controller="Auth" asp-action="Register" method="post" autocomplete="off">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
            <div class="auth-field">
                <label asp-for="Username">账号</label>
                <input asp-for="Username" placeholder="3-50 个字符" autocomplete="username" />
                <span asp-validation-for="Username" class="validation-message"></span>
            </div>
            <div class="auth-field">
                <label asp-for="Phone">手机号</label>
                <input asp-for="Phone" placeholder="请输入手机号" autocomplete="tel" />
                <span asp-validation-for="Phone" class="validation-message"></span>
            </div>
            <div class="auth-field">
                <label asp-for="Password">密码</label>
                <input asp-for="Password" placeholder="至少 6 个字符" autocomplete="new-password" />
                <span asp-validation-for="Password" class="validation-message"></span>
            </div>
            <div class="auth-field">
                <label asp-for="ConfirmPassword">确认密码</label>
                <input asp-for="ConfirmPassword" placeholder="请再次输入密码" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="validation-message"></span>
            </div>
            <button class="button primary auth-submit" type="submit">注册账号</button>
        </form>
        <p class="auth-switch">已有账号？<a asp-controller="Auth" asp-action="Login">返回登录</a></p>
    </div>
</section>
