@{
    ViewData["Title"] = "首页";
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var isAdmin = User.IsInRole("ADMIN");
    var isRunner = User.IsInRole("RUNNER");
}

<section class="dd-hero" id="top">
    <div class="dd-hero__copy">
        <p class="dd-eyebrow">JIRUN · 同济校园跑腿</p>
        <h1>校内需求，<br><span>一路送达</span></h1>
        <p class="dd-hero__sub">济跑跑连接普通用户、跑腿员与管理员，把代取、代送、外卖分发、支付退款和结算审计串成一条清楚链路。</p>

        <p class="dd-hero__hint">📍 校内代取 · 代送 · 外卖分发 —— 发布任务，跑腿员马上接单</p>

        <div class="dd-hero__actions">
            @if (!isAuthenticated)
            {
                <a class="dd-btn dd-btn--primary" asp-controller="Auth" asp-action="Register">立即创建账号</a>
                <a class="dd-btn dd-btn--ghost" asp-controller="Auth" asp-action="Login">登录济跑跑</a>
            }
            else if (isAdmin)
            {
                <a class="dd-btn dd-btn--primary" asp-controller="Task" asp-action="AdminConsole">进入运营后台</a>
                <a class="dd-btn dd-btn--ghost" asp-controller="Report" asp-action="Index">查看统计报表</a>
            }
            else if (isRunner)
            {
                <a class="dd-btn dd-btn--primary" asp-controller="Task" asp-action="Hall">进入任务大厅</a>
                <a class="dd-btn dd-btn--ghost" asp-controller="Task" asp-action="MyTasks">配送工作台</a>
            }
            else
            {
                <a class="dd-btn dd-btn--primary" asp-controller="Task" asp-action="Create">发布跑腿任务</a>
                <a class="dd-btn dd-btn--ghost" asp-controller="Task" asp-action="Index">查看我的订单</a>
            }
        </div>

        <div class="dd-hero__stats">
            <div class="dd-stat"><strong>3 类</strong><span>校园跑腿场景</span></div>
            <div class="dd-stat"><strong>三端</strong><span>用户 · 跑腿员 · 管理员</span></div>
            <div class="dd-stat"><strong>全流程</strong><span>下单 · 履约 · 售后</span></div>
        </div>
    </div>
</section>

@if (!isRunner && !isAdmin)
{
    <section class="dd-runner-band">
        <div class="dd-runner-band__inner">
            <div class="dd-runner-band__copy">
                <p class="dd-eyebrow">BECOME A RUNNER</p>
                <h2>成为济跑跑跑腿员</h2>
                <p>提交资格申请，审核通过后即可在任务大厅接单，利用课余时间赚取配送收入。</p>
                <a class="dd-btn dd-btn--primary" asp-controller="Runner" asp-action="Apply">申请跑腿员资格</a>
            </div>
            <div class="dd-runner-band__media">
                <img src="~/images/dasher.png" alt="成为跑腿员" />
            </div>
        </div>
    </section>
}

<section class="dd-section" id="services">
    <div class="dd-section__head">
        <h2>校园服务分类</h2>
        <p>选一种场景，一键发布你的跑腿需求。</p>
    </div>
    <div class="dd-category-grid">
        <a class="dd-category-card" asp-controller="Task" asp-action="Create">
            <span class="dd-category-card__icon">🍜</span>
            <strong>外卖分发</strong>
            <p>校门、食堂或商圈外卖集中分发到宿舍与指定节点。</p>
        </a>
        <a class="dd-category-card" asp-controller="Task" asp-action="Create">
            <span class="dd-category-card__icon">📦</span>
            <strong>快递代取</strong>
            <p>记录快递公司、取件码与送达位置，统一代取。</p>
        </a>
        <a class="dd-category-card" asp-controller="Task" asp-action="Create">
            <span class="dd-category-card__icon">🏃</span>
            <strong>私人跑腿</strong>
            <p>资料递送、物品转交等个性化校园委托。</p>
        </a>
    </div>
</section>

<section class="dd-section" id="workflow">
    <div class="dd-section__head">
        <h2>怎么使用济跑跑</h2>
        <p>从下单到售后，四步跑通一条完整链路。</p>
    </div>
    <div class="dd-step-grid">
        <div class="dd-step"><span class="dd-step__num">1</span><h3>发布任务</h3><p>填写取送位置、服务类型和费用，任务进入待接单。</p></div>
        <div class="dd-step"><span class="dd-step__num">2</span><h3>接单配送</h3><p>跑腿员在任务大厅抢单，按取货、配送、待确认履约。</p></div>
        <div class="dd-step"><span class="dd-step__num">3</span><h3>收货支付</h3><p>用户确认收货，并完成收货后支付。</p></div>
        <div class="dd-step"><span class="dd-step__num">4</span><h3>评价售后</h3><p>评价、投诉、退款、结算与审计持续闭环。</p></div>
    </div>
</section>

<section class="dd-section dd-role-band">
    <div class="dd-section__head">
        <h2>三端协同工作台</h2>
        <p>每个角色都有专属入口，直接进入对应功能。</p>
    </div>
    <div class="dd-role-grid">
        <article class="dd-role-card">
            <span class="dd-role-card__tag">用户端</span>
            <h3>发布与跟踪订单</h3>
            <p>发布任务、查看进度、确认收货、支付与评价投诉。</p>
            <div class="dd-role-card__links">
                @if (isAuthenticated)
                {
                    <a asp-controller="Task" asp-action="Create">发布任务</a>
                    <a asp-controller="Task" asp-action="Index">我的订单</a>
                }
                else
                {
                    <a asp-controller="Auth" asp-action="Login">登录</a>
                    <a asp-controller="Auth" asp-action="Register">注册</a>
                }
            </div>
        </article>
        <article class="dd-role-card">
            <span class="dd-role-card__tag">跑腿员端</span>
            <h3>接单与配送履约</h3>
            <p>任务大厅抢单、配送工作台更新状态、查看我的结算。</p>
            <div class="dd-role-card__links">
                @if (isRunner)
                {
                    <a asp-controller="Task" asp-action="Hall">任务大厅</a>
                    <a asp-controller="Task" asp-action="MyTasks">配送工作台</a>
                }
                else if (isAuthenticated)
                {
                    <a asp-controller="Runner" asp-action="Apply">申请跑腿员</a>
                }
                else
                {
                    <a asp-controller="Auth" asp-action="Login">登录后申请</a>
                }
            </div>
        </article>
        <article class="dd-role-card">
            <span class="dd-role-card__tag">管理员端</span>
            <h3>调度与运营管理</h3>
            <p>任务指派、跑腿员审核、退款、结算、审计与报表。</p>
            <div class="dd-role-card__links">
                @if (isAdmin)
                {
                    <a asp-controller="Task" asp-action="AdminConsole">指派控制台</a>
                    <a asp-controller="Settlement" asp-action="Index">结算管理</a>
                }
                else
                {
                    <a asp-controller="Auth" asp-action="Login">管理员登录</a>
                }
            </div>
        </article>
    </div>
</section>
