@model NodeIndexViewModel

@{
    ViewData["Title"] = "节点管理";
}

<section class="panel">
    <div class="section-header">
        <div>
            <p class="eyebrow">基础资料</p>
            <h1>节点管理</h1>
        </div>
        <a class="button primary" asp-action="Create">新增节点</a>
    </div>

    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>编号</th>
                    <th>类型</th>
                    <th>名称</th>
                    <th>位置</th>
                    <th>开放时间</th>
                    <th>状态</th>
                    <th>操作</th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Nodes.Count == 0)
            {
                <tr>
                    <td colspan="7" class="empty">暂无节点数据</td>
                </tr>
            }
            else
            {
                foreach (var node in Model.Nodes)
                {
                    <tr>
                        <td>@node.NodeId</td>
                        <td>@node.NodeTypeDisplayName</td>
                        <td>@node.NodeName</td>
                        <td>@node.Location</td>
                        <td>@(node.OpenTime ?? "-")</td>
                        <td><span class="badge @(node.NodeStatus == "NORMAL" ? "success" : "muted")">@node.NodeStatusDisplayName</span></td>
                        <td class="row-actions">
                            <a asp-action="Edit" asp-route-id="@node.NodeId">编辑</a>
                            <form asp-action="Delete" asp-route-id="@node.NodeId" method="post">
                                <button type="submit" class="link-button">删除</button>
                            </form>
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</section>
