@model NodeCreateViewModel

<div asp-validation-summary="ModelOnly" class="validation-summary"></div>

<label class="field">
    <span asp-for="NodeType"></span>
    <select asp-for="NodeType">
        <option value="GATE">校门</option>
        <option value="STATION">驿站</option>
        <option value="DISTRIBUTION">分发点</option>
    </select>
    <span asp-validation-for="NodeType" class="validation-message"></span>
</label>

<label class="field">
    <span asp-for="NodeName"></span>
    <input asp-for="NodeName" />
    <span asp-validation-for="NodeName" class="validation-message"></span>
</label>

<label class="field">
    <span asp-for="Location"></span>
    <input asp-for="Location" />
    <span asp-validation-for="Location" class="validation-message"></span>
</label>

<label class="field">
    <span asp-for="OpenTime"></span>
    <input asp-for="OpenTime" placeholder="如 08:00-22:00" />
    <span asp-validation-for="OpenTime" class="validation-message"></span>
</label>

<label class="field">
    <span asp-for="NodeStatus"></span>
    <select asp-for="NodeStatus">
        <option value="NORMAL">正常</option>
        <option value="CLOSED">关闭</option>
    </select>
    <span asp-validation-for="NodeStatus" class="validation-message"></span>
</label>
