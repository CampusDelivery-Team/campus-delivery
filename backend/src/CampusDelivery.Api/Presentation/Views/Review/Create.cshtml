@model ReviewCreateViewModel

@{
    ViewData["Title"] = "提交评价";
}

<section class="application-shell">
    <header class="application-heading">
        <p class="eyebrow">服务评价</p>
        <h1>评价本次跑腿服务</h1>
        <p>接派记录 #@Model.RecordId</p>
    </header>
    <form asp-action="Create" method="post" class="application-form">
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
        <input type="hidden" asp-for="RecordId" />
        <div class="application-field">
            <label asp-for="Rating"></label>
            <select asp-for="Rating">
                <option value="5">5 星 - 非常满意</option>
                <option value="4">4 星 - 满意</option>
                <option value="3">3 星 - 一般</option>
                <option value="2">2 星 - 不满意</option>
                <option value="1">1 星 - 非常不满意</option>
            </select>
            <span asp-validation-for="Rating" class="validation-message"></span>
        </div>
        <div class="application-field">
            <label asp-for="AnonymousFlag"></label>
            <select asp-for="AnonymousFlag">
                <option value="N">实名评价</option>
                <option value="Y">匿名评价</option>
            </select>
        </div>
        <div class="application-field">
            <label asp-for="CommentText"></label>
            <textarea asp-for="CommentText" rows="5" maxlength="300" placeholder="说说本次服务体验"></textarea>
            <span asp-validation-for="CommentText" class="validation-message"></span>
        </div>
        <div class="application-actions">
            <button type="submit" class="button primary">提交评价</button>
            <a class="button" asp-action="Index" asp-route-recordId="@Model.RecordId">返回</a>
        </div>
    </form>
</section>
