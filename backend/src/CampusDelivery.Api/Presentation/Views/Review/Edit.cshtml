@model ReviewEditViewModel

@{
    ViewData["Title"] = "编辑评价";
}

<section class="application-shell">
    <header class="application-heading">
        <p class="eyebrow">评价管理</p>
        <h1>编辑评价 #@Model.ReviewId</h1>
    </header>
    <form asp-action="Edit" method="post" class="application-form">
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
        <input type="hidden" asp-for="ReviewId" />
        <input type="hidden" asp-for="RecordId" />
        <div class="application-field">
            <label asp-for="Rating"></label>
            <select asp-for="Rating">
                <option value="5">5 星</option><option value="4">4 星</option><option value="3">3 星</option><option value="2">2 星</option><option value="1">1 星</option>
            </select>
        </div>
        <div class="application-field">
            <label asp-for="AnonymousFlag"></label>
            <select asp-for="AnonymousFlag"><option value="N">实名</option><option value="Y">匿名</option></select>
        </div>
        <div class="application-field">
            <label asp-for="CommentText"></label>
            <textarea asp-for="CommentText" rows="5" maxlength="300"></textarea>
        </div>
        <div class="application-actions">
            <button type="submit" class="button primary">保存修改</button>
            <a class="button" asp-action="All">返回列表</a>
        </div>
    </form>
</section>
