@model ReviewEditViewModel

@{
    ViewData["Title"] = "编辑评价";
}

<section class="application-shell">
    <header class="application-heading">
        <p class="eyebrow">用户反馈</p>
        <h1>编辑评价 #@Model.ReviewId</h1>
        <p>修改评分后，系统会自动按新旧评分差值调整跑腿员信誉分。</p>
    </header>

    <form asp-action="Edit" method="post" class="application-form">
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <input type="hidden" asp-for="ReviewId" />

        <div class="application-field">
            <label asp-for="Rating"></label>
            <select asp-for="Rating" class="form-control">
                <option value="">请选择评分</option>
                <option value="1">⭐ 很差</option>
                <option value="2">⭐⭐ 差</option>
                <option value="3">⭐⭐⭐ 一般</option>
                <option value="4">⭐⭐⭐⭐ 好</option>
                <option value="5">⭐⭐⭐⭐⭐ 很好</option>
            </select>
            <span asp-validation-for="Rating" class="validation-message"></span>
        </div>

        <div class="application-field">
            <label asp-for="AnonymousFlag"></label>
            <div>
                <input type="radio" asp-for="AnonymousFlag" value="N" /> 实名
                <input type="radio" asp-for="AnonymousFlag" value="Y" /> 匿名
            </div>
            <span asp-validation-for="AnonymousFlag" class="validation-message"></span>
        </div>

        <div class="application-field">
            <label asp-for="CommentText"></label>
            <textarea asp-for="CommentText" rows="4" maxlength="300"></textarea>
            <span asp-validation-for="CommentText" class="validation-message"></span>
        </div>

        <div class="application-actions">
            <button type="submit" class="button primary">保存修改</button>
            <a class="button" asp-action="@(User.IsInRole("ADMIN") ? "All" : "MyReviews")">返回列表</a>
        </div>
    </form>
</section>
