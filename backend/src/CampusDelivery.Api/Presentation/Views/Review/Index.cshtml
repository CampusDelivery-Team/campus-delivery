@model ReviewListItemViewModel?

@{
    ViewData["Title"] = "任务评价";
    int recordId = ViewBag.RecordId ?? 0;
    IReadOnlyList<ReviewListItemViewModel> rows = Model == null
        ? Array.Empty<ReviewListItemViewModel>()
        : new[] { Model };
}

<section class="panel management-panel">
    <div class="section-header management-heading">
        <div>
            <p class="eyebrow">服务评价</p>
            <h1>接派记录 #@recordId</h1>
        </div>
        @if (Model == null)
        {
            <a class="button primary" asp-action="Create" asp-route-recordId="@recordId">提交评价</a>
        }
    </div>
    @if (TempData["SuccessMessage"] is string success)
    {
        <div class="inline-notice success">@success</div>
    }
    <partial name="_ReviewTable" model="rows" />
</section>
