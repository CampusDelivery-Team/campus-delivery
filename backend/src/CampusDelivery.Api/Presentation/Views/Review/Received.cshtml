@model List<ReviewListItemViewModel>
@{
    ViewData["Title"] = "我收到的评价";
    var page = ViewBag.Page ?? 1;
    var pageSize = ViewBag.PageSize ?? 10;
    var total = ViewBag.Total ?? 0;
    var totalPages = ViewBag.TotalPages ?? 0;
}

<section class="panel">
    <div class="section-header">
        <div>
            <p class="eyebrow">RUNNER REVIEW</p>
            <h1>我收到的评价</h1>
            <p>用户对我完成的配送服务给出的评价。</p>
        </div>
    </div>

    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>评价编号</th>
                    <th>任务</th>
                    <th>评分</th>
                    <th>匿名</th>
                    <th>评价内容</th>
                    <th>信用变动</th>
                    <th>时间</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="7" class="empty">还没有收到任何评价</td></tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>#@item.ReviewId</td>
                            <td>#@item.TaskId</td>
                            <td>@item.RatingDisplayName</td>
                            <td>@item.AnonymousDisplayName</td>
                            <td>@(string.IsNullOrWhiteSpace(item.CommentText) ? "—" : item.CommentText)</td>
                            <td>@item.CreditDeltaDisplayName</td>
                            <td>@item.ReviewedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (totalPages > 1)
    {
        <nav class="pagination">
            <a asp-action="Received" asp-route-page="@(page - 1)" asp-route-pageSize="@pageSize" class="@(page <= 1 ? "disabled" : "")">上一页</a>
            <span>第 @(page) / @totalPages 页</span>
            <a asp-action="Received" asp-route-page="@(page + 1)" asp-route-pageSize="@pageSize" class="@(page >= totalPages ? "disabled" : "")">下一页</a>
        </nav>
    }
</section>
