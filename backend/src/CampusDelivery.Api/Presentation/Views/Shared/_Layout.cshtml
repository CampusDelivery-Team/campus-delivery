<!doctype html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - 济跑跑 JiRun</title>
    <link rel="icon" href="~/images/favicon.ico" sizes="any" asp-append-version="true" />
    <link rel="apple-touch-icon" href="~/images/jirun-mark-192.png" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="topbar">
        <a class="brand" asp-controller="Home" asp-action="Index">
            <img class="brand-mark" src="~/images/jirun-mark-64.png" alt="" />
            <div class="brand-copy">
                <strong>济跑跑</strong>
                <small>JiRun Campus Service</small>
            </div>
        </a>
        <nav class="nav">
            <a asp-controller="Home" asp-action="Index" asp-fragment="services">服务类型</a>
            <a asp-controller="Home" asp-action="Index" asp-fragment="workflow">服务流程</a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                @if (!User.IsInRole("ADMIN"))
                {
                    <a asp-controller="Task" asp-action="Create">发布任务</a>
                    <a asp-controller="Payment" asp-action="Status">支付查询</a>
                }

                @if (User.IsInRole("RUNNER"))
                {
                    <a asp-controller="Task" asp-action="Hall">任务大厅</a>
                }
                else
                {
                    <a asp-controller="Task" asp-action="Index">我的任务</a>
                }

                <a asp-controller="Task" asp-action="Receipt">确认收货</a>
                <a asp-controller="Complaint" asp-action="MyComplaints">我的投诉</a>

                @if (User.IsInRole("RUNNER"))
                {
                    <a asp-controller="Task" asp-action="MyTasks">配送工作台</a>
                    <a asp-controller="Settlement" asp-action="My">我的结算</a>
                }

                <a asp-controller="User" asp-action="Profile">个人中心</a>

                @if (!User.IsInRole("ADMIN"))
                {
                    <a asp-controller="Runner" asp-action="Apply">跑腿员资格</a>
                }

                @if (User.IsInRole("ADMIN"))
                {
                    <details class="nav-menu">
                        <summary>管理</summary>
                        <div class="nav-menu-panel">
                            <span class="nav-menu-label">任务调度</span>
                            <a asp-controller="Task" asp-action="AdminConsole">指派控制台</a>
                            <span class="nav-menu-label">支付退款</span>
                            <a asp-controller="Refund" asp-action="AdminIndex">退款审核</a>
                            <span class="nav-menu-label">基础资料</span>
                            <a asp-controller="Node" asp-action="Index">节点管理</a>
                            <a asp-controller="ServiceType" asp-action="Index">服务类型</a>
                            <a asp-controller="ServiceNodeRule" asp-action="Index">服务节点规则</a>
                            <span class="nav-menu-label">人员管理</span>
                            <a asp-controller="Account" asp-action="Index">账号管理</a>
                            <a asp-controller="Runner" asp-action="Index">跑腿员资料</a>
                            <a asp-controller="Runner" asp-action="Pending">跑腿员审核</a>
                            <span class="nav-menu-label">评价投诉</span>
                            <a asp-controller="Review" asp-action="All">评价管理</a>
                            <a asp-controller="Complaint" asp-action="Index">投诉管理</a>
                            <span class="nav-menu-label">结算审计</span>
                            <a asp-controller="Settlement" asp-action="Index">结算管理</a>
                            <a asp-controller="Audit" asp-action="Index">审计日志</a>
                            <a asp-controller="Report" asp-action="Index">统计报表</a>
                            <span class="nav-menu-label">系统</span>
                            <a asp-controller="Database" asp-action="Status">系统检测</a>
                        </div>
                    </details>
                }

                <span class="nav-user">@User.Identity.Name</span>
                <form class="nav-logout" asp-controller="Auth" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="nav-cta">退出登录</button>
                </form>
            }
            else
            {
                <a asp-controller="Auth" asp-action="Login">登录</a>
                <a class="nav-cta" asp-controller="Auth" asp-action="Register">注册</a>
            }
        </nav>
    </header>

    <main class="page">
        @RenderBody()
    </main>

    <script>
        (() => {
            const menu = document.querySelector(".nav-menu");
            if (!menu) return;

            document.addEventListener("click", event => {
                if (!menu.contains(event.target)) menu.removeAttribute("open");
            });
            document.addEventListener("keydown", event => {
                if (event.key === "Escape") menu.removeAttribute("open");
            });
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
