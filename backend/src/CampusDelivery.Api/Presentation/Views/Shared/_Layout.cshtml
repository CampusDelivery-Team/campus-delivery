<!doctype html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - 校园跑腿服务管理系统</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="topbar">
        <a class="brand" asp-controller="Home" asp-action="Index">
            <span>跑</span>
            <strong>校园跑腿</strong>
            <small>Campus Runner Service</small>
        </a>
        <nav class="nav">
            <a asp-controller="Home" asp-action="Index" asp-fragment="services">服务类型</a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-controller="User" asp-action="Profile">个人中心</a>

                @if (User.IsInRole("ADMIN"))
                {
                    <a asp-controller="Node" asp-action="Index">节点资料</a>
                    <a asp-controller="Database" asp-action="Status">系统检测</a>
                }

                <span class="nav-user">@User.Identity.Name</span>
                <form class="nav-logout" asp-controller="Auth" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="nav-cta">退出登录</button>
                </form>
            }
            else
            {
                <a asp-controller="Home" asp-action="Index" asp-fragment="workflow">服务流程</a>
                <a asp-controller="Auth" asp-action="Login">登录</a>
                <a class="nav-cta" asp-controller="Auth" asp-action="Register">注册</a>
            }
        </nav>
    </header>

    <main class="page">
        @RenderBody()
    </main>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
