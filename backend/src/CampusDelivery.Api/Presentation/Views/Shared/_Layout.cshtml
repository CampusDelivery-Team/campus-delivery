@functions {
    string NavClass(string controller, string action = "")
    {
        var cc = ViewContext.RouteData.Values["controller"]?.ToString();
        var ca = ViewContext.RouteData.Values["action"]?.ToString();
        bool active = string.Equals(cc, controller, StringComparison.OrdinalIgnoreCase)
            && (action.Length == 0 || string.Equals(ca, action, StringComparison.OrdinalIgnoreCase));
        return active ? "is-active" : "";
    }
}

<!doctype html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - 济跑跑 JiRun</title>
    <link rel="icon" href="~/images/favicon.ico" sizes="any" asp-append-version="true" />
    <link rel="apple-touch-icon" href="~/images/jirun-mark-192.png" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="@(User.Identity?.IsAuthenticated == true ? "app-shell" : "")">
    @if (User.Identity?.IsAuthenticated == true)
    {
        <aside class="dd-sidenav">
            <a class="dd-sidenav__brand" asp-controller="Home" asp-action="Index">
                <img src="~/images/jirun-mark-64.png" alt="" />
                <span>
                    <strong>济跑跑</strong>
                    <small>JiRun Campus</small>
                </span>
            </a>
            <nav class="dd-sidenav__nav">
                <a class="@NavClass("Home", "Index")" asp-controller="Home" asp-action="Index"><span class="dd-nav-ico">🏠</span>首页</a>

                @if (!User.IsInRole("ADMIN"))
                {
                    <a class="@NavClass("Task", "Create")" asp-controller="Task" asp-action="Create"><span class="dd-nav-ico">📝</span>发布任务</a>
                    <a class="@NavClass("Payment", "Status")" asp-controller="Payment" asp-action="Status"><span class="dd-nav-ico">💳</span>支付查询</a>
                }

                @if (User.IsInRole("RUNNER"))
                {
                    <a class="@NavClass("Task", "Hall")" asp-controller="Task" asp-action="Hall"><span class="dd-nav-ico">🏪</span>任务大厅</a>
                }

                <a class="@NavClass("Task", "Index")" asp-controller="Task" asp-action="Index"><span class="dd-nav-ico">📋</span>我的任务</a>

                <a class="@NavClass("Task", "Receipt")" asp-controller="Task" asp-action="Receipt"><span class="dd-nav-ico">✅</span>确认收货</a>
                <a class="@NavClass("Review", "MyReviews")" asp-controller="Review" asp-action="MyReviews"><span class="dd-nav-ico">⭐</span>我的评价</a>
                <a class="@NavClass("Complaint", "MyComplaints")" asp-controller="Complaint" asp-action="MyComplaints"><span class="dd-nav-ico">📢</span>我的投诉</a>

                @if (User.IsInRole("RUNNER"))
                {
                    <a class="@NavClass("Task", "MyTasks")" asp-controller="Task" asp-action="MyTasks"><span class="dd-nav-ico">🛵</span>配送工作台</a>
                    <a class="@NavClass("Settlement", "My")" asp-controller="Settlement" asp-action="My"><span class="dd-nav-ico">💰</span>我的结算</a>
                }

                <a class="@NavClass("User", "Profile")" asp-controller="User" asp-action="Profile"><span class="dd-nav-ico">👤</span>个人中心</a>

                @if (!User.IsInRole("ADMIN"))
                {
                    <a class="@NavClass("Runner", "Apply")" asp-controller="Runner" asp-action="Apply"><span class="dd-nav-ico">🪪</span>跑腿员资格</a>
                }

                @if (User.IsInRole("ADMIN"))
                {
                    <span class="dd-sidenav__label">任务调度</span>
                    <a class="@NavClass("Task", "AdminConsole")" asp-controller="Task" asp-action="AdminConsole">指派控制台</a>
                    <span class="dd-sidenav__label">支付退款</span>
                    <a class="@NavClass("Refund", "AdminIndex")" asp-controller="Refund" asp-action="AdminIndex">退款审核</a>
                    <span class="dd-sidenav__label">基础资料</span>
                    <a class="@NavClass("Node", "Index")" asp-controller="Node" asp-action="Index">节点管理</a>
                    <a class="@NavClass("ServiceType", "Index")" asp-controller="ServiceType" asp-action="Index">服务类型</a>
                    <a class="@NavClass("ServiceNodeRule", "Index")" asp-controller="ServiceNodeRule" asp-action="Index">服务节点规则</a>
                    <span class="dd-sidenav__label">人员管理</span>
                    <a class="@NavClass("Account", "Index")" asp-controller="Account" asp-action="Index">账号管理</a>
                    <a class="@NavClass("Runner", "Index")" asp-controller="Runner" asp-action="Index">跑腿员资料</a>
                    <a class="@NavClass("Runner", "Pending")" asp-controller="Runner" asp-action="Pending">跑腿员审核</a>
                    <span class="dd-sidenav__label">评价投诉</span>
                    <a class="@NavClass("Review", "All")" asp-controller="Review" asp-action="All">评价管理</a>
                    <a class="@NavClass("Complaint", "Index")" asp-controller="Complaint" asp-action="Index">投诉管理</a>
                    <span class="dd-sidenav__label">结算审计</span>
                    <a class="@NavClass("Settlement", "Index")" asp-controller="Settlement" asp-action="Index">结算管理</a>
                    <a class="@NavClass("Audit", "Index")" asp-controller="Audit" asp-action="Index">审计日志</a>
                    <a class="@NavClass("Report", "Index")" asp-controller="Report" asp-action="Index">统计报表</a>
                    <span class="dd-sidenav__label">系统</span>
                    <a class="@NavClass("Database", "Status")" asp-controller="Database" asp-action="Status">系统检测</a>
                }
            </nav>
            <div class="dd-sidenav__footer">
                <span class="dd-sidenav__user">@User.Identity.Name</span>
                <form asp-controller="Auth" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="dd-sidenav__logout">退出登录</button>
                </form>
            </div>
        </aside>
        <main class="dd-main">
            @RenderBody()
        </main>
    }
    else
    {
        <header class="dd-mini-bar">
            <a class="dd-mini-bar__brand" asp-controller="Home" asp-action="Index">
                <img src="~/images/jirun-mark-64.png" alt="" />
                <span>
                    <strong>济跑跑</strong>
                    <small>JiRun Campus</small>
                </span>
            </a>
            <nav class="dd-mini-bar__actions">
                <a class="dd-mini-link" asp-controller="Auth" asp-action="Login">登录</a>
                <a class="dd-mini-cta" asp-controller="Auth" asp-action="Register">注册</a>
            </nav>
        </header>
        <main class="page">
            @RenderBody()
        </main>
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
