<!doctype html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - 校园中转分发与跑腿服务管理系统</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="topbar">
        <a class="brand" asp-controller="Home" asp-action="Index">校园跑腿管理系统</a>
        <nav class="nav">
            <a asp-controller="Home" asp-action="Index">首页</a>
            <a asp-controller="Node" asp-action="Index">节点管理</a>
            <a asp-controller="Database" asp-action="Status">数据库状态</a>
        </nav>
    </header>

    <main class="page">
        @RenderBody()
    </main>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
