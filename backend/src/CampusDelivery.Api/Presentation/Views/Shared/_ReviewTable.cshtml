@model List<ReviewListItemViewModel>

<div class="table-wrap">
    <table>
        <thead>
            <tr>
                <th>编号</th>
                <th>接派记录</th>
                <th>评分</th>
                <th>匿名</th>
                <th>评价内容</th>
                <th>信用变动</th>
                <th>时间</th>
                <th>操作</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Count == 0)
            {
                <tr><td colspan="8">暂无评价记录</td></tr>
            }
            else
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td>#@item.ReviewId</td>
                        <td>#@item.RecordId</td>
                        <td>@item.RatingDisplayName</td>
                        <td>@item.AnonymousDisplayName</td>
                        <td>@(item.CommentText ?? "-")</td>
                        <td>@item.CreditDeltaDisplayName</td>
                        <td>@item.ReviewedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>
                            <a class="button" asp-action="Edit" asp-route-id="@item.ReviewId">编辑</a>
                            <form asp-action="Delete" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.ReviewId" />
                                <button type="submit" class="button">删除</button>
                            </form>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>