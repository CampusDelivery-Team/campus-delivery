@model TaskIndexViewModel

@{
    ViewData["Title"] = Model.IsAdminView ? "全部任务" : "我的任务";
}

<section class="panel">
    <div class="section-header">
        <div>
            <p class="eyebrow">TASK CENTER</p>
            <h1>@ViewData["Title"]</h1>
            <p>@(Model.IsAdminView ? "这里展示系统中的全部任务。" : "这里展示当前账号发布过的任务。")</p>
        </div>
        <a class="button primary" asp-action="Create">发布任务</a>
    </div>

    @if (TempData["TaskMessage"] is string message)
    {
        <div class="inline-notice">@message</div>
    }

    <div class="table-wrap">
        <table class="service-type-table task-list-table @(Model.IsAdminView ? "task-list-table-admin" : "task-list-table-user")">
            <colgroup>
                <col class="task-list-col-id" />
                @if (Model.IsAdminView)
                {
                    <col class="task-list-col-publisher" />
                }
                <col class="task-list-col-kind" />
                <col class="task-list-col-title" />
                <col class="task-list-col-service" />
                <col class="task-list-col-price" />
                <col class="task-list-col-status" />
                <col class="task-list-col-address" />
                <col class="task-list-col-node" />
                <col class="task-list-col-created" />
                <col class="task-list-col-actions" />
            </colgroup>
            <thead>
                <tr>
                    <th>编号</th>
                    @if (Model.IsAdminView)
                    {
                        <th>发布用户</th>
                    }
                    <th>任务类型</th>
                    <th>任务标题</th>
                    <th>服务类型</th>
                    <th>价格</th>
                    <th>状态</th>
                    <th>地址</th>
                    <th>节点</th>
                    <th>创建时间</th>
                    <th>操作</th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Tasks.Count == 0)
            {
                <tr>
                    <td colspan="@(Model.IsAdminView ? 11 : 10)" class="empty">当前还没有任务记录</td>
                </tr>
            }
            else
            {
                foreach (var task in Model.Tasks)
                {
                    <tr>
                        <td><span class="task-list-cell" title="#@task.TaskId">#@task.TaskId</span></td>
                        @if (Model.IsAdminView)
                        {
                            <td><span class="task-list-cell" title="@task.PublisherUsername">@task.PublisherUsername</span></td>
                        }
                        <td><span class="task-list-cell" title="@task.TaskKindDisplayName">@task.TaskKindDisplayName</span></td>
                        <td>
                            <span class="task-list-cell task-list-title" title="@task.TaskTitle">@task.TaskTitle</span>
                            <small class="task-list-subtext" title="@task.UrgentFlagDisplayName">@task.UrgentFlagDisplayName</small>
                        </td>
                        <td><span class="task-list-cell" title="@task.ServiceName">@task.ServiceName</span></td>
                        <td><span class="task-list-cell" title="@($"{task.TaskPrice:F2} 元")">@task.TaskPrice.ToString("F2") 元</span></td>
                        <td><span class="task-list-cell" title="@task.TaskStatusDisplayName">@task.TaskStatusDisplayName</span></td>
                        <td><span class="task-list-cell" title="@task.AddressSummary">@task.AddressSummary</span></td>
                        <td><span class="task-list-cell" title="@task.NodeName">@task.NodeName</span></td>
                        <td><span class="task-list-cell" title="@task.CreatedAt.ToString("yyyy-MM-dd HH:mm")">@task.CreatedAt.ToString("yyyy-MM-dd HH:mm")</span></td>
                        <td>
                            <div class="service-type-row-actions">
                                <a asp-action="Details" asp-route-id="@task.TaskId">详情</a>
                                @if (task.CanCancel)
                                {
                                    <form asp-action="Cancel" asp-route-id="@task.TaskId" method="post" onsubmit="return confirm('确认取消这个任务吗？');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="link-button danger-action">取消</button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</section>
