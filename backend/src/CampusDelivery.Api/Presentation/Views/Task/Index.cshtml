@model TaskIndexViewModel

@{
    ViewData["Title"] = "我的任务";
}

<section class="panel">
    <div class="section-header">
        <div>
            <p class="eyebrow">TASK CENTER</p>
            <h1>@ViewData["Title"]</h1>
            <p>这里展示当前账号发布过的任务。</p>
        </div>
        <a class="button primary" asp-action="Create">发布任务</a>
    </div>

    @if (TempData["TaskMessage"] is string message)
    {
        <div class="inline-notice">@message</div>
    }

    <div class="table-wrap">
        <table class="service-type-table">
            <thead>
                <tr>
                    <th>编号</th>
                    <th>任务类型</th>
                    <th>任务标题</th>
                    <th>服务类型</th>
                    <th>价格</th>
                    <th>状态</th>
                    <th>地址</th>
                    <th>节点</th>
                    <th>创建时间</th>
                    <th>操作</th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Tasks.Count == 0)
            {
                <tr>
                    <td colspan="9" class="empty">当前还没有任务记录</td>
                </tr>
            }
            else
            {
                foreach (var task in Model.Tasks)
                {
                    <tr>
                        <td>#@task.TaskId</td>
                        <td>@task.TaskKindDisplayName</td>
                        <td>
                            <div>@task.TaskTitle</div>
                            <small>@task.UrgentFlagDisplayName</small>
                        </td>
                        <td>@task.ServiceName</td>
                        <td>@task.TaskPrice.ToString("F2") 元</td>
                        <td>@task.TaskStatusDisplayName</td>
                        <td>@task.AddressSummary</td>
                        <td>@task.NodeName</td>
                        <td>@task.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>
                            <div class="service-type-row-actions">
                                @if (task.CanCancel)
                                {
                                    <form asp-action="Cancel" asp-route-id="@task.TaskId" method="post" onsubmit="return confirm('确认取消这个任务吗？');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="link-button danger-action">取消</button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</section>
