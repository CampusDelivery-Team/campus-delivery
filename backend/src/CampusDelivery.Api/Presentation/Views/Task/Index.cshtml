@model TaskHallViewModel

@{
    ViewData["Title"] = "任务大厅";
}

<section class="panel task-page">
    <div class="section-header task-page__header">
        <div>
            <p class="eyebrow">任务调度</p>
            <h1>任务大厅</h1>
        </div>
        <div class="task-page__identity">
            @if (Model.ActiveRunnerId.HasValue)
            {
                <span class="badge success task-page__badge">跑腿员在线 (ID: @Model.ActiveRunnerId.Value)</span>
            }
            else
            {
                <span class="badge danger task-page__badge">无跑腿员资质 (仅限只读)</span>
            }
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="task-alert task-alert--success">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="task-alert task-alert--error">@TempData["ErrorMessage"]</div>
    }

    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>编号</th>
                    <th>服务类型</th>
                    <th>任务标题</th>
                    <th>交接节点</th>
                    <th>送达地址</th>
                    <th>金额</th>
                    <th>加急</th>
                    <th>状态</th>
                    <th>操作</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Tasks.Count == 0)
                {
                    <tr>
                        <td colspan="9" class="empty task-table__empty">暂无等待接单的任务</td>
                    </tr>
                }
                else
                {
                    foreach (var task in Model.Tasks)
                    {
                        <tr>
                            <td>@task.TaskId</td>
                            <td><strong>@task.ServiceTypeName</strong></td>
                            <td>@task.TaskTitle</td>
                            <td>@task.NodeName</td>
                            <td>@task.AddressDisplay</td>
                            <td class="task-price">¥@task.TaskPrice.ToString("F2")</td>
                            <td>
                                @if (task.UrgentFlag == "Y")
                                {
                                    <span class="badge danger">加急</span>
                                }
                                else
                                {
                                    <span class="muted-text">普通</span>
                                }
                            </td>
                            <td><span class="badge audit-pending">@task.TaskStatusDisplayName</span></td>
                            <td>
                                @if (Model.ActiveRunnerId.HasValue && Model.ActiveRunnerStatus == "FREE")
                                {
                                    <form asp-action="Grab" method="post" class="task-inline-form">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="taskId" value="@task.TaskId" />
                                        <button type="submit" class="button primary task-button--small">抢单</button>
                                    </form>
                                }
                                else
                                {
                                    <button class="button task-button--small" disabled>不可接单</button>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <partial name="_TaskPagination" model="@(new TaskPaginationViewModel { ActionName = "Index", PageNumber = Model.PageNumber, TotalPages = Model.TotalPages, PageSize = Model.PageSize })" />
</section>
