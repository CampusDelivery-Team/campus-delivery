@model MyTasksViewModel

@{
    ViewData["Title"] = "个人配送工作台";
}

<section class="panel task-page">
    <div class="section-header task-page__header">
        <div>
            <p class="eyebrow">任务调度</p>
            <h1>个人配送工作台</h1>
        </div>
        <span class="badge success task-page__badge">跑腿员 ID: @Model.RunnerId</span>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="task-alert task-alert--success">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="task-alert task-alert--error">@TempData["ErrorMessage"]</div>
    }

    @if (Model.ActiveTasks.Count == 0)
    {
        <div class="task-empty-card">
            <h3>当前没有正在配送中的订单</h3>
            <p>可以前往 <a asp-action="Hall">任务大厅</a> 查看待接单任务。</p>
        </div>
    }
    else
    {
        <div class="task-card-list">
            @foreach (var task in Model.ActiveTasks)
            {
                <article class="task-card">
                    <div class="task-card__header">
                        <div>
                            <span class="badge task-badge--service">@task.ServiceTypeName</span>
                            <strong class="task-card__title">@task.TaskTitle</strong>
                            <span class="task-card__number">单号: #@task.TaskId</span>
                        </div>
                        <div class="task-card__summary">
                            <span class="task-price">¥@task.TaskPrice.ToString("F2")</span>
                            <span class="badge audit-pending">@task.TaskStatusDisplayName</span>
                        </div>
                    </div>

                    <div class="task-card__details">
                        <div>
                            <p><strong>交接地点：</strong>@task.NodeName</p>
                            <p><strong>送达地址：</strong>@task.AddressDisplay</p>
                            <p><strong>接单时间：</strong>@task.AssignedAt.ToString("yyyy-MM-dd HH:mm:ss")</p>
                        </div>
                        <div class="task-card__contact">
                            <p><strong>联系人：</strong>@task.ContactName</p>
                            <p><strong>联系电话：</strong>@task.ContactPhone</p>
                        </div>
                    </div>

                    <div class="task-card__footer">
                        <div class="actions">
                            @if (task.TaskStatus == "ASSIGNED")
                            {
                                <form asp-action="UpdateStatus" method="post" class="task-inline-form">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="taskId" value="@task.TaskId" />
                                    <input type="hidden" name="targetStatus" value="PICKED_UP" />
                                    <button type="submit" class="button primary task-button--compact">确认已取件</button>
                                </form>
                            }
                            else if (task.TaskStatus == "PICKED_UP")
                            {
                                <form asp-action="UpdateStatus" method="post" class="task-inline-form">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="taskId" value="@task.TaskId" />
                                    <input type="hidden" name="targetStatus" value="DELIVERING" />
                                    <button type="submit" class="button primary task-button--compact">开始配送</button>
                                </form>
                            }
                            else if (task.TaskStatus == "DELIVERING")
                            {
                                <form asp-action="UpdateStatus" method="post" class="task-inline-form">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="taskId" value="@task.TaskId" />
                                    <input type="hidden" name="targetStatus" value="WAIT_CONFIRM" />
                                    <button type="submit" class="button primary task-button--compact">确认已送达</button>
                                </form>
                            }
                            else if (task.ReceiptConfirmed)
                            {
                                <span class="task-status-text task-status-text--success">用户已确认收货，等待支付</span>
                            }
                            else
                            {
                                <span class="task-status-text">等待任务发布者确认收货</span>
                            }
                        </div>

                        <details class="task-log">
                            <summary>查看状态变更日志 (@task.Logs.Count)</summary>
                            <div class="task-log__list">
                                @foreach (var log in task.Logs)
                                {
                                    <div class="task-log__item">
                                        <span>
                                            @if (log.ActionName != null)
                                            {
                                                <strong>@log.ActionName</strong>
                                            }
                                            else
                                            {
                                                <text>@(log.StatusBeforeDisplayName ?? "初始化") → <strong>@log.StatusAfterDisplayName</strong></text>
                                            }
                                            <small>(@log.OperatorName)</small>
                                        </span>
                                        <span>@log.OperatedAt.ToString("HH:mm:ss")</span>
                                    </div>
                                }
                            </div>
                        </details>
                    </div>
                </article>
            }
        </div>
    }

    <partial name="_TaskPagination" model="@(new TaskPaginationViewModel { ActionName = "MyTasks", PageNumber = Model.PageNumber, TotalPages = Model.TotalPages, PageSize = Model.PageSize })" />
</section>
