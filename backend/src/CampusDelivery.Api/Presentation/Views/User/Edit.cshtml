@model CampusDelivery.Api.Presentation.ViewModels.UserViewModel
@{
    ViewData["Title"] = "编辑个人信息";
}

<section class="profile-page profile-edit-page">
    <div class="profile-edit-heading">
        <p class="eyebrow">ACCOUNT SETTINGS</p>
        <h1>编辑个人信息</h1>
        <p>账户和系统身份由平台维护，当前仅支持修改联系电话。</p>
    </div>

    <form class="profile-edit-form" asp-controller="User" asp-action="Edit" method="post" autocomplete="off">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <div class="profile-readonly-grid">
            <div>
                <span>登录账号</span>
                <strong>@Model.Username</strong>
            </div>
            <div>
                <span>系统身份</span>
                <strong>@Model.UserRole</strong>
                <small>不可自行修改</small>
            </div>
        </div>

        <div class="profile-edit-field">
            <label asp-for="Phone">联系电话</label>
            <input asp-for="Phone" autocomplete="tel" placeholder="请输入新的手机号" />
            <span asp-validation-for="Phone" class="validation-message"></span>
        </div>

        <div class="profile-footer-actions">
            <a class="button" asp-controller="User" asp-action="Profile">取消</a>
            <button type="submit" class="button primary">保存修改</button>
        </div>
    </form>
</section>
