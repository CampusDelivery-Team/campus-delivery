@model CampusDelivery.Api.Presentation.ViewModels.UserViewModel
@{
    ViewData["Title"] = "修改信息";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0 rounded-lg">
                <div class="card-header bg-dark text-white text-center py-3">
                    <h4 class="font-weight-light my-1">修改个人信息</h4>
                </div>
                <div class="card-body p-4">
                    
                    <form asp-controller="User" asp-action="Edit" method="post" autocomplete="off">
                        <div asp-validation-summary="ModelOnly" class="text-danger fw-bold mb-3"></div>
                        
                        <input type="hidden" asp-for="UserId" />

                        <div class="mb-3">
                            <label asp-for="Username" class="form-label fw-bold">账号</label>
                            <input asp-for="Username" class="form-control bg-light" readonly />
                        </div>

                        <div class="mb-3">
                            <label asp-for="UserRole" class="form-label fw-bold">系统身份</label>
                            <input asp-for="UserRole" class="form-control bg-light" readonly />
                        </div>

                        <div class="mb-4">
                            <label asp-for="Phone" class="form-label fw-bold text-primary">手机号</label>
                            <input asp-for="Phone" class="form-control border-primary" placeholder="请输入新的手机号" />
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <a href="/User/Profile" class="btn btn-secondary">取消返回</a>
                            <button type="submit" class="btn btn-primary">保存修改</button>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>
