@model CampusDelivery.Api.Presentation.ViewModels.UserViewModel
@{
    ViewData["Title"] = "个人中心";
    var avatarText = string.IsNullOrWhiteSpace(Model.Username) ? "我" : Model.Username[..1].ToUpperInvariant();
}

<section class="profile-page">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="profile-notice" role="status">@TempData["SuccessMessage"]</div>
    }

    <section class="profile-overview">
        <div class="profile-avatar" aria-label="@Model.Username 的头像">@avatarText</div>
        <div class="profile-identity">
            <p class="eyebrow">CAMPUS RUNNER PROFILE</p>
            <h1>@Model.Username</h1>
            <p>校园跑腿服务账户</p>
        </div>
        <div class="profile-role">
            <span>系统身份</span>
            <strong>@Model.UserRole</strong>
            <small>由系统管理员统一分配</small>
        </div>
    </section>

    <section class="profile-section">
        <div class="profile-section__heading">
            <div>
                <p class="eyebrow">ACCOUNT</p>
                <h2>账户信息</h2>
            </div>
            <a class="button primary" asp-controller="User" asp-action="Edit">编辑联系方式</a>
        </div>

        <dl class="profile-details">
            <div>
                <dt>账户编号</dt>
                <dd>#@Model.UserId</dd>
            </div>
            <div>
                <dt>登录账号</dt>
                <dd>@Model.Username</dd>
            </div>
            <div>
                <dt>联系电话</dt>
                <dd>@Model.Phone</dd>
            </div>
            <div>
                <dt>账户状态</dt>
                <dd><span class="profile-status">正常可用</span></dd>
            </div>
        </dl>
    </section>

    <section class="profile-section profile-address">
        <div class="profile-section__heading">
            <div>
                <p class="eyebrow">DELIVERY ADDRESS</p>
                <h2>常用收货地址</h2>
            </div>
            <div class="profile-section__actions">
                <span class="address-badge">@(Model.HasAddress ? "默认地址" : "待设置")</span>
                <a class="button" asp-controller="Address" asp-action="Index">管理地址</a>
            </div>
        </div>
        <div class="address-content">
            <div class="address-icon" aria-hidden="true">址</div>
            <div>
                <strong>@Model.AddressSummary</strong>
                <p>@Model.AddressContact</p>
            </div>
        </div>
    </section>

    <div class="profile-footer-actions">
        <a class="button" asp-controller="Home" asp-action="Index">返回首页</a>
        <form asp-controller="User" asp-action="CancelAccount" method="post" onsubmit="return confirm('注销后账号将无法登录，确定继续吗？');">
            @Html.AntiForgeryToken()
            <button type="submit" class="profile-cancel">注销账号</button>
        </form>
        <form asp-controller="Auth" asp-action="Logout" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="profile-logout">退出登录</button>
        </form>
    </div>
</section>
