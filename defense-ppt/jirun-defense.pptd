version: v2
title: 济跑跑工程档案 · 课程设计答辩
size: [960, 540]
theme:
  colors:
    paper: "#F2EDE3"
    ink: "#1B1813"
    meta: "#8B8271"
    hairline: "#C8BFA9"
    crimson: "#C22441"
  textStyles:
    headline:
      fontSize: 30
      fontFamily: 思源宋体
      color: "$ink"
    body:
      fontSize: 11.5
      fontFamily: MiSans
      color: "$ink"
      lineHeight: 1.6
    metaLabel:
      fontSize: 8.5
      fontFamily: MiSans
      color: "$meta"
      letterSpacing: 2
    register:
      fontSize: 10.5
      fontFamily: MiSans
      color: "$ink"
      lineHeight: 1.5
    folio:
      fontSize: 10
      fontFamily: 思源宋体
      color: "$meta"
pages:
  - pages/01_cover.page
  - pages/02_abstract.page
  - pages/03_problem.page
  - pages/04_flow.page
  - pages/05_functions.page
  - pages/06_architecture.page
  - pages/07_database.page
  - pages/08_statemachine.page
  - pages/09_consistency.page
  - pages/10_plates.page
  - pages/11_testing.page
  - pages/12_team.page
  - pages/13_closing.page
