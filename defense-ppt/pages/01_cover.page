    viewBox: [100, 100]
    path: "M0,0 L100,0 L100,14 L14,14 L14,100 L0,100 Z"
    rotation: 90
    fill: {type: solid, color: "$ink"}
  - elementId: crop-br
    elementType: shape
    bounds: [912, 492, 22, 22]
    shapeName: custom
    viewBox: [100, 100]
    path: "M0,0 L100,0 L100,14 L14,14 L14,100 L0,100 Z"
    rotation: 180
