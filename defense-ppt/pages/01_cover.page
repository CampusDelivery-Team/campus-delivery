  - elementId: crop-tl
    elementType: shape
    bounds: [26, 26, 22, 22]
    shapeName: custom
    viewBox: [100, 100]
    path: "M0,0 L100,0 L100,14 L14,14 L14,100 L0,100 Z"
    fill: {type: solid, color: "$ink"}
  - elementId: crop-tr
    elementType: shape
    bounds: [912, 26, 22, 22]
