pageType: content
background: {type: solid, color: "$bg"}
notes: 工作量总览：24 张表、16 个控制器、84 个动作端点、55 个视图；强调 15 个以上功能点含实质业务逻辑。
elements:
  - elementId: kicker
    elementType: text
    bounds: [60, 30, 500, 20]
    content: {style: "$kicker", wrap: false, text: 02 · 系统功能总览}
  - elementId: title
    elementType: text
    bounds: [60, 50, 700, 42]
    content: {style: "$pagetitle", wrap: false, text: 功能全景：20+ 功能点覆盖三类角色}
  - elementId: titlebar
    elementType: shape
    bounds: [60, 100, 56, 4]
    shapeName: rect
    fill: {type: gradient, gradientType: linear, angle: 0, stops: [{position: 0, color: "$primary"}, {position: 1, color: "$teal"}]}
  - elementId: pagenum
    elementType: text
    bounds: [880, 505, 60, 18]
    content: {style: "$small", align: [right, middle], wrap: false, text: 03 / 12}
  - elementId: stat1bg
    elementType: shape
    bounds: [60, 124, 198, 86]
    shapeName: roundRect
    adjustments: [9000]
    fill: {type: gradient, gradientType: linear, angle: 45, stops: [{position: 0, color: "#0B4FB3"}, {position: 1, color: "#00A6A6"}]}
  - elementId: stat1
    elementType: text
    bounds: [60, 132, 198, 70]
    content:
      align: [center, middle]
      text: |
        <p style="text-align:center"><span style="font-size:30px; color:#FFFFFF"><strong>24</strong></span></p>
        <p style="text-align:center; margin-top:2px"><span style="font-size:12px; color:#DCE7F5">数据库表（要求 ≥ 12）</span></p>
  - elementId: stat2bg
    elementType: shape
    bounds: [274, 124, 198, 86]
    shapeName: roundRect
    adjustments: [9000]
    fill: {type: solid, color: "$white"}
    border: {style: solid, width: 1, color: "$border"}
  - elementId: stat2
    elementType: text
    bounds: [274, 132, 198, 70]
    content:
      align: [center, middle]
      text: |
        <p style="text-align:center"><span style="font-size:30px; color:$primary"><strong>84</strong></span></p>
        <p style="text-align:center; margin-top:2px"><span style="font-size:12px; color:$subtext">动作端点 · 16 个控制器</span></p>
  - elementId: stat3bg
    elementType: shape
    bounds: [488, 124, 198, 86]
    shapeName: roundRect
    adjustments: [9000]
    fill: {type: solid, color: "$white"}
    border: {style: solid, width: 1, color: "$border"}
  - elementId: stat3
    elementType: text
    bounds: [488, 132, 198, 70]
    content:
      align: [center, middle]
      text: |
        <p style="text-align:center"><span style="font-size:30px; color:$primary"><strong>55</strong></span></p>
        <p style="text-align:center; margin-top:2px"><span style="font-size:12px; color:$subtext">Razor 视图页面</span></p>
  - elementId: stat4bg
    elementType: shape
    bounds: [702, 124, 198, 86]
    shapeName: roundRect
    adjustments: [9000]
    fill: {type: solid, color: "$white"}
    border: {style: solid, width: 1, color: "$border"}
  - elementId: stat4
    elementType: text
    bounds: [702, 132, 198, 70]
    content:
      align: [center, middle]
      text: |
        <p style="text-align:center"><span style="font-size:30px; color:$accent"><strong>15+</strong></span></p>
        <p style="text-align:center; margin-top:2px"><span style="font-size:12px; color:$subtext">含业务逻辑的功能点</span></p>
  - elementId: modtitle
    elementType: text
    bounds: [60, 230, 400, 22]
    content: {fontSize: 15, color: "$dark", bold: true, wrap: false, text: 十大功能模块}
  - elementId: modtable
    elementType: table
    bounds: [60, 260, 840, 236]
    columnWidths: [0.16, 0.34, 0.16, 0.34]
    rowHeights: [0.14, 0.172, 0.172, 0.172, 0.172, 0.172]
    style: "$default"
    rows:
      - - text: 模块
        - text: 功能点
        - text: 模块
        - text: 功能点
      - - text: 账户与地址
        - text: 注册 / 登录 / 资料 / 账号状态 / 地址 CRUD / 默认地址
        - text: 任务中心
        - text: 发布（餐饮/快递/私人）/ 列表 / 详情 / 取消 / 大厅接单
      - - text: 配送执行
        - text: 派单 / 接单 / 送达上报 / 收货确认
        - text: 支付退款
        - text: 订单支付 / 状态查询 / 退款申请与审批
      - - text: 评价投诉
        - text: 发表（星级+信誉分联动）/ 修改 / 删除 / 列表 / 投诉处理
        - text: 结算中心
        - text: 候选计算 / 结算单生成 / 确认 / 打款
      - - text: 审计监督
        - text: 支付 / 退款 / 状态日志三类审计登记与核查
        - text: 运营报表
        - text: 交易额、净收入、订单量等运营汇总
      - - text: 基础数据
        - text: 节点 / 服务类型 / 节点-服务规则管理
        - text: 运维诊断
        - text: 数据库连接状态诊断页（管理员）
