pageType: content
background: {type: solid, color: "$bg"}
notes: 分工页：答辩前替换为真实姓名与分工。每人要能讲清自己的模块、关键决策和工作量证据。
elements:
  - elementId: kicker
    elementType: text
    bounds: [60, 30, 500, 20]
    content: {style: "$kicker", wrap: false, text: 10 · 团队协作}
  - elementId: title
    elementType: text
    bounds: [60, 50, 700, 42]
    content: {style: "$pagetitle", wrap: false, text: 分工与个人贡献}
  - elementId: titlebar
    elementType: shape
    bounds: [60, 100, 56, 4]
    shapeName: rect
    fill: {type: gradient, gradientType: linear, angle: 0, stops: [{position: 0, color: "$primary"}, {position: 1, color: "$teal"}]}
  - elementId: pagenum
    elementType: text
    bounds: [880, 505, 60, 18]
    content: {style: "$small", align: [right, middle], wrap: false, text: 11 / 12}
  - elementId: teamtable
    elementType: table
    bounds: [60, 132, 840, 268]
    columnWidths: [0.14, 0.30, 0.34, 0.22]
    rowHeights: [0.14, 0.172, 0.172, 0.172, 0.172, 0.172]
    style: "$default"
    rows:
      - - text: 成员
        - text: 负责模块
        - text: 关键贡献
        - text: 工作量证据
      - - text: 成员A
        - text: 账户 / 地址 / 用户管理
        - text: 账号生命周期、密码哈希迁移工具
        - text: 提交记录 + 测试用例
      - - text: 成员B
        - text: 任务 / 接派 / 配送执行
        - text: 任务状态机、并发接单控制
        - text: 提交记录 + 验收截图
      - - text: 成员C
        - text: 支付 / 退款 / 评价 / 投诉
        - text: 资金链路、信誉分联动、ORA-00933 缺陷修复
        - text: 提交记录 + 缺陷记录
      - - text: 成员D
        - text: 结算 / 审计 / 报表
        - text: 结算候选算法、三类审计核查
        - text: 提交记录 + SQL 证据
      - - text: 全组
        - text: 数据库设计 / 文档 / 联调
        - text: 24 表设计、14 份文档、云端共享库联调
        - text: docs/ 目录
  - elementId: tipcard
    elementType: shape
    bounds: [60, 424, 840, 84]
    shapeName: roundRect
    adjustments: [8000]
    fill: {type: solid, color: "$lightblue"}
  - elementId: tiptext
    elementType: text
    bounds: [84, 438, 800, 58]
    content:
      fontSize: 13
      lineHeight: 1.55
      text: |
        <p><span style="color:$primary"><strong>答辩自述建议：</strong></span>每人用 30 秒讲清三件事——我负责的模块是什么、我做了哪个关键设计决策、</p>
        <p>它解决了什么问题。避免只报模块名，要讲出"为什么这么做"。</p>
