      fontSize: 36
      color: "$white"
      bold: true
      align: [center, middle]
      wrap: false
      text: 总结与展望
  - elementId: stats
    elementType: text
    bounds: [130, 244, 700, 36]
    content:
      fontSize: 16
      color: "#DCE7F5"
      align: [center, middle]
      wrap: false
      text: |
        <p style="text-align:center"><strong>24</strong> 张表 · <strong>84</strong> 个端点 · <strong>五层</strong> MVC · <strong>39</strong> 项测试 · 完整业务闭环</p>
  - elementId: outlookcard
    elementType: shape
    bounds: [190, 306, 580, 130]
    shapeName: roundRect
    adjustments: [8000]
    fill: {type: solid, color: "#FFFFFF14"}
  - elementId: outlook
    elementType: text
    bounds: [226, 322, 508, 100]
    content:
      fontSize: 14
      color: "#DCE7F5"
